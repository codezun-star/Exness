---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TabBar from '../components/TabBar.astro';
import AppMenu from '../components/AppMenu.astro';
import ExitIntent from '../components/ExitIntent.astro';
import Consent from '../components/Consent.astro';
import GeoNotice from '../components/GeoNotice.astro';
import CountryMemory from '../components/CountryMemory.astro';
import EdgeRails from '../components/EdgeRails.astro';
import { SITE, ANALYTICS, VERIFICATION } from '../config/site';
import { countryLocale, type Country } from '../config/countries';
import { useT, LANG, DIR, INTL_LOCALE } from '../i18n/ui';
import { abs, pageTitle, metaDescription, type Alternate } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  /** Ruta canónica sin dominio, p. ej. "mx" o "blog/mi-articulo" */
  path: string;
  /**
   * Tipo de Open Graph. Un artículo del blog TIENE que declararse `article`:
   * es lo que hace que al compartirlo salga con autor y fecha en vez de como
   * una página cualquiera, y lo que leen los agregadores para fechar el
   * contenido. Todo lo demás del sitio es `website`.
   */
  ogType?: 'website' | 'article';
  /** Sólo para `ogType="article"`: alimenta article:published_time. */
  published?: Date;
  /** Sólo para `ogType="article"`: alimenta article:modified_time. */
  modified?: Date;
  /** Sólo para `ogType="article"`: autor y etiquetas del artículo. */
  author?: string;
  tags?: string[];
  alternates?: Alternate[];
  /** Objeto JSON-LD ya construido con graph() */
  schema?: Record<string, unknown>;
  /**
   * Color del documento entero. `paper` es el valor por defecto porque el
   * sitio es claro: el blanco es la superficie dominante y el negro está
   * reservado a la cabecera, al pie y a los avisos. Sólo el 404 y el
   * redirector piden `ink`, que son pantallas únicas sin recorrido.
   */
  theme?: 'ink' | 'paper';
  country?: Country;
  noindex?: boolean;
  /**
   * Página sin elementos de conversión flotantes: ni modal de salida, ni aviso
   * geográfico, ni raíles. La barra de pestañas se queda, porque es la
   * navegación de la app y no un anuncio.
   */
  bare?: boolean;
  /** Página interior: en móvil la cabecera muestra la flecha de volver. */
  back?: { href: string; label: string };
  /**
   * Raíles de rascacielos anclados al margen del viewport. Se apagan en las
   * páginas que ya montan los suyos dentro del contenido, para no acabar con
   * cuatro rascacielos en una pantalla ancha.
   */
  rails?: boolean;
}

const {
  title,
  description,
  path,
  ogType = 'website',
  published,
  modified,
  author,
  tags = [],
  alternates = [],
  schema,
  theme = 'paper',
  country,
  noindex = false,
  bare = false,
  back,
  rails = true,
} = Astro.props;

const t = useT(country);

/** En una landing de mercado el locale lleva región: "es_MX", no "es_419". */
const ogLocale = country ? countryLocale(country) : INTL_LOCALE.replace('-', '_');
const canonical = abs(path);
const fullTitle = pageTitle(title);
const desc = metaDescription(description);

const robots = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';
---

<html lang={LANG} dir={DIR}>
  <head>
    <meta charset="utf-8" />
    {/*
      `viewport-fit=cover` deja que el sitio instalado ocupe la pantalla entera,
      muesca incluida. Las zonas seguras las respetan la cabecera, la barra de
      pestañas y las hojas con env(safe-area-inset-*).
    */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />

    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}${SITE.ogImage}`} />
    {/*
      Las medidas de la imagen no son opcionales para quien la consume: sin
      ellas, Facebook y LinkedIn tienen que descargar el archivo antes de
      decidir cómo maquetar la tarjeta, y la primera vez que se comparte un
      enlace sale sin imagen.
    */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={`${SITE.brand} — ${title}`} />

    {ogType === 'article' && published && (
      <meta property="article:published_time" content={published.toISOString()} />
    )}
    {ogType === 'article' && (modified ?? published) && (
      <meta property="article:modified_time" content={(modified ?? published)!.toISOString()} />
    )}
    {ogType === 'article' && author && <meta property="article:author" content={author} />}
    {ogType === 'article' && tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={`${SITE.url}${SITE.ogImage}`} />
    <meta name="twitter:image:alt" content={`${SITE.brand} — ${title}`} />

    {/*
      Tinta en todas las páginas, también las claras: lo primero que se ve bajo
      la barra del navegador es la cabecera, que es negra, y una franja blanca
      encima la separaba del resto de la barra de app.
    */}
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="format-detection" content="telephone=no" />

    {/* Instalable como app: nombre bajo el icono y barra de estado sobre la cabecera. */}
    <meta name="application-name" content={SITE.brand} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={SITE.brand} />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon.png" sizes="96x96" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.brand} — ${t('blog.title')}`} href="/rss.xml" />

    {VERIFICATION.google && <meta name="google-site-verification" content={VERIFICATION.google} />}
    {VERIFICATION.bing && <meta name="msvalidate.01" content={VERIFICATION.bing} />}
    {VERIFICATION.yandex && <meta name="yandex-verification" content={VERIFICATION.yandex} />}

    {/*
      Tres hosts de terceros, y cada uno con el trato que le corresponde.

      El redirector de socios sólo necesita el DNS resuelto: el visitante no
      pide nada de ahí hasta que pulsa, pero cuando pulsa le ahorramos una
      vuelta de red que en móvil se nota.

      El CDN de creatividades sí sirve imágenes en la propia página, así que
      va con preconnect completo —DNS, TCP y TLS por adelantado— porque el
      banner se pide en cuanto entra en pantalla.

      Las incrustaciones de vídeo se quedan en dns-prefetch a propósito: el
      iframe es perezoso y abrir su TLS de entrada gastaría una conexión que
      la mayoría de visitantes no llega a usar.
    */}
    <link rel="dns-prefetch" href="https://one.exnessonelink.com" />
    <link rel="preconnect" href="https://d3dpet1g0ty5ed.cloudfront.net" crossorigin />
    <link rel="dns-prefetch" href="https://d3dpet1g0ty5ed.cloudfront.net" />
    <link rel="dns-prefetch" href="https://brandfolder.com" />

    {schema && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(schema)}
      />
    )}

    <script is:inline>
      // dataLayer disponible antes de cualquier interacción, para no perder
      // los clics que ocurren mientras el consentimiento sigue pendiente.
      //
      // La función se llamaba `xmTrack`: era un resto del sitio de XM sobre el
      // que se montó esta arquitectura. Nada aquí es de XM, y un identificador
      // global con la marca de otro bróker es justo lo que no conviene tener
      // en el HTML de un sitio de socio de Exness.
      window.dataLayer = window.dataLayer || [];
      window.track = function (name, params) {
        window.dataLayer.push(Object.assign({ event: name }, params || {}));
      };
    </script>

    {/*
      Service worker: lo que hace que el sitio abra sin red y se pueda instalar.
      Sólo en producción: en `astro dev` una caché de por medio sirve versiones
      viejas de lo que se está editando. Qué cachea y qué no está en public/sw.js.
    */}
    {import.meta.env.PROD && (
      <script is:inline>
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', function () {
            navigator.serviceWorker.register('/sw.js').catch(function () {});
          });
        }
      </script>
    )}
  </head>

  <body data-theme={theme} class="app-shell">
    {/*
      Enlace de salto. Decía «Menú», que es la etiqueta del nav: quien navega
      con teclado o lector de pantalla lo oía anunciado como un menú y se
      saltaba lo único que le ahorra tabular por la cabecera entera.
    */}
    <a href="#main" class="sr-only">{t('nav.skip')}</a>

    <Header country={country} back={back} />

    <main id="main">
      <slot />
    </main>

    <Footer country={country} />

    <TabBar country={country} />
    <AppMenu country={country} />
    {!bare && <ExitIntent country={country} />}
    {!bare && <GeoNotice currentCountry={country?.code} />}
    {!bare && rails && <EdgeRails seed={`edge-${path || 'home'}`} />}
    <CountryMemory country={country?.code} />
    <Consent ga4={ANALYTICS.ga4} gtm={ANALYTICS.gtm} metaPixel={ANALYTICS.metaPixel} tiktokPixel={ANALYTICS.tiktokPixel} clarity={ANALYTICS.clarity} />
  </body>
</html>
