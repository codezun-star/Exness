---
/**
 * Iconos de la capa de app — y sólo de ella.
 *
 * El contenido del sitio sigue sin iconos: ahí la jerarquía la ponen los
 * índices numéricos y las etiquetas micro. Pero una barra de pestañas o una
 * hoja de menú sin pictogramas no se reconoce como tal en móvil, así que la
 * navegación los lleva. Misma geometría que el símbolo de la marca: trazo
 * recto, extremos cuadrados, esquinas vivas. Nada redondeado.
 *
 * Son decorativos por definición: la etiqueta siempre va en texto al lado, o
 * en el aria-label del botón que los contiene.
 */
interface Props {
  name: keyof typeof PATHS;
  size?: number;
  class?: string;
}

const PATHS = {
  home: 'M3.5 11 12 3.5l8.5 7.5M5.5 9.5V20.5h13V9.5M10 20.5v-6h4v6',
  accounts: 'M3.5 7.5h17v12h-17zM3.5 11.5h17M7.5 3.5h9',
  platforms: 'M3.5 4.5h17v11h-17zM9 20.5h6M12 15.5v5M7 12l3-3 2.5 2.5L17 7',
  countries: 'M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17M3.5 12h17M12 3.5c-2.5 2.5-3.5 5.5-3.5 8.5s1 6 3.5 8.5M12 3.5c2.5 2.5 3.5 5.5 3.5 8.5s-1 6-3.5 8.5',
  blog: 'M5.5 3.5h9l4 4v13h-13zM14.5 3.5v4h4M8.5 11.5h7M8.5 14.5h7M8.5 17.5h4',
  faq: 'M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6v.6M12 16.5v1',
  menu: 'M4 4h6.5v6.5H4zM13.5 4H20v6.5h-6.5zM4 13.5h6.5V20H4zM13.5 13.5H20V20h-6.5z',
  install: 'M12 3.5v11M7.5 10l4.5 4.5 4.5-4.5M4.5 16v4.5h15V16',
  open: 'M12 5v14M5 12h14',
  back: 'M15 4.5 7.5 12l7.5 7.5',
  next: 'M9 4.5 16.5 12 9 19.5',
  close: 'M5.5 5.5l13 13M18.5 5.5l-13 13',
  offline: 'M1.5 9a16 16 0 0 1 21 0M5 12.5a11 11 0 0 1 14 0M8.5 16a6 6 0 0 1 7 0M12 19.5v.5M3 3l18 18',
} as const;

const { name, size = 24, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
>
  <path d={PATHS[name]} />
</svg>
