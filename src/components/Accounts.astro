---
import { ACCOUNTS } from '../config/offers';
import { goUrl } from '../config/affiliate';
import type { Country } from '../config/countries';
import { useT } from '../i18n/ui';

interface Props {
  country?: Country;
}

const { country } = Astro.props;
const t = useT(country);

const nf = new Intl.NumberFormat('en-US');
---

<section class="band band-paper" id="cuentas">
  <div class="wrap">
    <p class="eyebrow">{t('nav.accounts')}</p>
    <h2 class="display display-l accounts-title">{t('accounts.title')}</h2>
    <p class="lede accounts-lede">{t('accounts.sub')}</p>

    <div class="table-scroll">
      <table class="data accounts-table">
        <thead>
          <tr>
            <th scope="col">{t('accounts.col.type')}</th>
            <th scope="col">{t('accounts.col.min')}</th>
            <th scope="col">{t('accounts.col.spread')}</th>
            <th scope="col">{t('accounts.col.commission')}</th>
            <th scope="col">{t('accounts.col.lot')}</th>
            <th scope="col"><span class="sr-only">{t('accounts.cta')}</span></th>
          </tr>
        </thead>
        <tbody>
          {ACCOUNTS.map((account) => (
            <tr class={account.featured ? 'featured' : undefined}>
              <th scope="row" class="account-name">
                {account.name}
                {account.featured && <span class="tag">{t('accounts.recommended')}</span>}
              </th>
              <td class="num" data-label={t('accounts.col.min')}>{nf.format(account.minDeposit)} USD</td>
              <td class="num" data-label={t('accounts.col.spread')}>{account.spreadFrom === '—' ? '—' : `${account.spreadFrom} pips`}</td>
              <td class="num" data-label={t('accounts.col.commission')}>{account.commission}</td>
              <td class="num" data-label={t('accounts.col.lot')}>{account.lotSize}</td>
              <td class="account-action">
                <a
                  href={goUrl('real', `accounts-${account.key}`, country?.code)}
                  rel="sponsored nofollow noopener"
                  data-cta={`accounts-${account.key}`}
                >{t('accounts.cta')}</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="accounts-note">{t('accounts.note')}</p>
  </div>
</section>

<style>
  .accounts-title { max-width: 16ch; margin-bottom: 1.25rem; }
  .accounts-lede { margin: 0 0 clamp(2rem, 4vw, 3rem); }

  .account-name {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    white-space: nowrap;
  }

  .account-action { text-align: end; white-space: nowrap; }

  .account-action a {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-ink);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }

  .account-action a:hover { color: var(--color-ink); }

  /*
    En móvil la tabla deja de serlo: seis columnas en 390 px obligaban a
    desplazar de lado para ver la comisión, que es justo el dato que
    distingue una cuenta de otra. Cada cuenta pasa a ser una ficha de lista
    —nombre arriba, cuatro datos en rejilla de dos, acción a todo lo ancho—
    y cada dato lleva su etiqueta desde data-label, porque la cabecera de la
    tabla ya no está encima.
  */
  @media (max-width: 47.99rem) {
    .table-scroll { overflow: visible; }

    .accounts-table,
    .accounts-table tbody { display: block; min-width: 0; }

    .accounts-table thead { display: none; }

    .accounts-table tbody { border-top: 1px solid var(--color-line); }

    .accounts-table tr {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.875rem 1rem;
      padding-block: 1.25rem 0.5rem;
      border-bottom: 1px solid var(--color-line);
    }

    .accounts-table th,
    .accounts-table td {
      padding: 0;
      border: 0;
    }

    .accounts-table .account-name {
      grid-column: 1 / -1;
      font-size: 1.125rem;
    }

    .accounts-table td.num {
      font-size: 0.9375rem;
      white-space: normal;
    }

    .accounts-table td.num::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 0.25rem;
      font-family: var(--font-sans);
      font-size: 0.625rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-muted);
    }

    /* La recomendada conserva su fondo y su filete, ahora sobre la fila entera. */
    .accounts-table tr.featured {
      margin-inline: -1rem;
      padding-inline: 1rem;
      box-shadow: inset 3px 0 0 var(--color-accent);
    }

    .accounts-table .account-action {
      grid-column: 1 / -1;
      text-align: start;
    }

    .accounts-table .account-action a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-block-size: 2.75rem;
      border-bottom: 0;
      border-top: 1px solid var(--color-line);
      padding-bottom: 0;
    }

    .accounts-table .account-action a::after { content: '→'; font-size: 1rem; }
  }

  .accounts-note {
    margin: 1.75rem 0 0;
    font-size: 0.8125rem;
    color: var(--color-muted);
    max-width: 60ch;
  }
</style>
