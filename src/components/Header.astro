---
import CountrySwitcher from './CountrySwitcher.astro';
import Icon from './Icon.astro';
import { SITE, BRAND } from '../config/site';
import { goUrl } from '../config/affiliate';
import type { Country } from '../config/countries';
import { useT, countryPath, blogPath } from '../i18n/ui';

interface Props {
  country?: Country;
  /**
   * Página interior (artículo, legal): en móvil la cabecera muestra la flecha
   * de volver, como en cualquier app. `href` es el destino si no hay historial
   * propio al que volver —el visitante llegó desde Google o un enlace directo—.
   */
  back?: { href: string; label: string };
}

const { country, back } = Astro.props;
const t = useT(country);

/** En una página de país, "inicio" es ese país. Fuera de él, el selector. */
const home = country ? countryPath(country.code) : '/';

/**
 * Fuera de una landing de mercado, estos enlaces nacen apuntando a la portada
 * y CountryMemory les antepone el mercado recordado en el navegador
 * ("/#cuentas" -> "/hn/#cuentas"). El marcador sólo se pone cuando hace
 * falta: en una página de país el enlace ya lleva el mercado correcto.
 */
const market = country ? undefined : true;

const nav = [
  { label: t('nav.accounts'), href: `${home}#cuentas`, market },
  { label: t('nav.platforms'), href: `${home}#plataformas`, market },
  // "Países" es la única entrada que no se reescribe: fuera de una landing
  // lleva a la portada, que es donde está la retícula de mercados.
  { label: t('nav.countries'), href: country ? `${home}#paises` : '/' },
  { label: t('nav.blog'), href: blogPath() },
  { label: t('nav.faq'), href: `${home}#faq`, market },
];
---

<header class="site-header on-ink">
  <div class="wrap site-header-inner">
    {back && (
      <a class="app-back" href={back.href} data-back aria-label={`${t('nav.back')}: ${back.label}`}>
        <Icon name="back" />
      </a>
    )}

    <a href={home} class="wordmark" data-market-link={market} aria-label={SITE.brand}>
      <img
        src={BRAND.lockup.src}
        width={BRAND.lockup.width}
        height={BRAND.lockup.height}
        alt={SITE.brand}
        decoding="async"
        fetchpriority="high"
      />
    </a>

    <nav class="site-nav" aria-label={t('nav.menu')}>
      {nav.map((item) => (
        <a href={item.href} data-market-link={item.market}>{item.label}</a>
      ))}
    </nav>

    {/*
      En móvil ya no hay hamburguesa: la navegación vive en la barra de
      pestañas inferior y en la hoja de menú (TabBar + AppMenu), al alcance del
      pulgar. Aquí sólo quedan la marca y el mercado.
    */}
    <div class="site-header-actions">
      <CountrySwitcher country={country} />
      <a
        class="btn btn-accent site-header-cta"
        href={goUrl('real', 'header', country?.code)}
        rel="sponsored nofollow noopener"
        data-cta="header"
      >{t('nav.cta')}</a>
    </div>
  </div>
</header>

<style>
  /*
    En móvil es una barra de app: opaca, más baja y extendida bajo la barra de
    estado cuando el sitio se abre instalado. Opaca no es sólo estética: un
    `backdrop-filter` convierte la cabecera en el bloque contenedor de sus
    hijos `position: fixed`, y el selector de países —que en móvil es una hoja
    anclada al borde inferior de la pantalla— se quedaría anclado a la
    cabecera. El cristal esmerilado vuelve a partir de 64rem, donde el panel
    es un desplegable.
  */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-ink);
    border-bottom: 1px solid var(--color-line-ink);
    color: var(--color-paper);
    padding-top: env(safe-area-inset-top);
    view-transition-name: app-bar;
    -webkit-user-select: none;
    user-select: none;
  }

  /* Con el selector abierto, la hoja tiene que quedar por encima de la barra
     de pestañas, que es hermana de la cabecera y no hija. */
  .site-header:has(.country-switch[open]) { z-index: 90; }

  .site-header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-block-size: var(--app-bar-h);
  }

  .app-back {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    margin-inline: -0.75rem -1rem;
    color: var(--color-paper);
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .app-back:active { transform: translateX(-2px); color: var(--color-accent); }

  .wordmark {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex: none;
    transition: opacity 0.15s ease;
  }

  .wordmark:hover { opacity: 0.78; }

  .wordmark img {
    display: block;
    block-size: 1.5rem;
    inline-size: auto;
  }

  @media (min-width: 30rem) {
    .wordmark img { block-size: 1.75rem; }
  }

  @media (min-width: 64rem) {
    .wordmark img { block-size: 2rem; }
  }

  .site-nav {
    display: none;
    align-items: center;
    gap: 1.75rem;
    margin-inline-start: auto;
  }

  .site-nav a {
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-muted-2);
    transition: color 0.15s ease;
  }

  .site-nav a:hover { color: var(--color-paper); }

  .site-header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-inline-start: auto;
  }

  .site-header-cta {
    display: none;
    padding: 0.75rem 1.375rem;
    font-size: 0.8125rem;
  }

  @media (min-width: 64rem) {
    .site-header {
      background: rgba(11, 11, 12, 0.92);
      backdrop-filter: saturate(140%) blur(12px);
    }

    .site-nav { display: flex; }
    .site-header-actions { margin-inline-start: 0; }
    .site-header-cta { display: inline-flex; }
    .app-back { display: none; }
  }
</style>

<script>
  /**
   * Volver como en una app: si el visitante llegó desde otra página del sitio,
   * la flecha deshace ese paso —mismo scroll, mismo estado— en lugar de abrir
   * el índice desde arriba. Si entró directo, el enlace lleva a `href`.
   */
  document.querySelector<HTMLAnchorElement>('[data-back]')?.addEventListener('click', (event) => {
    let sameSite = false;
    try {
      sameSite = new URL(document.referrer).origin === location.origin;
    } catch {
      /* Sin referrer: entrada directa. */
    }
    if (sameSite && history.length > 1) {
      event.preventDefault();
      history.back();
    }
  });
</script>
