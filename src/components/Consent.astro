---
import { useT, legalPath } from '../i18n/ui';

interface Props {
  ga4?: string;
  gtm?: string;
  metaPixel?: string;
  tiktokPixel?: string;
  clarity?: string;
}

const { ga4 = '', gtm = '', metaPixel = '', tiktokPixel = '', clarity = '' } = Astro.props;
const t = useT();
const anyTag = Boolean(ga4 || gtm || metaPixel || tiktokPixel || clarity);
---

{anyTag && (
  <>
    <div class="consent on-ink" id="consent" hidden>
      <div class="wrap consent-inner">
        <p class="consent-text">
          {t('consent.text')}
          <a href={legalPath('cookies')}>{t('legal.cookies')}</a>
        </p>
        <div class="consent-actions">
          <button class="btn btn-ghost" type="button" id="consent-reject">{t('consent.reject')}</button>
          <button class="btn btn-accent" type="button" id="consent-accept">{t('consent.accept')}</button>
        </div>
      </div>
    </div>

    <style>
      .consent {
        position: fixed;
        inset-inline: 0;
        bottom: 0;
        z-index: 80;
        background: var(--color-ink-2);
        border-top: 2px solid var(--color-accent);
        padding-block: 1.125rem;
        padding-bottom: calc(1.125rem + env(safe-area-inset-bottom));
        color: var(--color-paper);
      }

      .consent-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .consent-text {
        margin: 0;
        font-size: 0.8125rem;
        line-height: 1.55;
        color: var(--color-muted-2);
        max-width: 62ch;
      }

      .consent-text a {
        color: var(--color-accent-2);
        text-decoration: underline;
        text-underline-offset: 2px;
        margin-inline-start: 0.375rem;
      }

      .consent-actions {
        display: flex;
        gap: 0.625rem;
        flex: none;
      }

      .consent-actions .btn {
        padding: 0.625rem 1.25rem;
        font-size: 0.8125rem;
      }
    </style>

    <script is:inline define:vars={{ ga4, gtm, metaPixel, tiktokPixel, clarity }}>
      (function () {
        var KEY = 'exness-consent';
        var banner = document.getElementById('consent');
        var saved = localStorage.getItem(KEY);

        function loadScript(src, attrs) {
          var s = document.createElement('script');
          s.async = true;
          s.src = src;
          Object.keys(attrs || {}).forEach(function (k) { s.setAttribute(k, attrs[k]); });
          document.head.appendChild(s);
          return s;
        }

        function loadTags() {
          if (gtm) {
            loadScript('https://www.googletagmanager.com/gtm.js?id=' + gtm);
          }
          if (ga4) {
            loadScript('https://www.googletagmanager.com/gtag/js?id=' + ga4);
            window.gtag = function () { window.dataLayer.push(arguments); };
            window.gtag('js', new Date());
            window.gtag('config', ga4, { anonymize_ip: true });
          }
          if (metaPixel) {
            !(function (f, b, e, v, n, t, s) {
              if (f.fbq) return; n = f.fbq = function () {
                n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
              };
              if (!f._fbq) f._fbq = n; n.push = n; n.loaded = true; n.version = '2.0'; n.queue = [];
              t = b.createElement(e); t.async = true; t.src = v;
              s = b.getElementsByTagName(e)[0]; s.parentNode.insertBefore(t, s);
            })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
            window.fbq('init', metaPixel);
            window.fbq('track', 'PageView');
          }
          if (tiktokPixel) {
            !(function (w, d, t) {
              w.TiktokAnalyticsObject = t; var ttq = (w[t] = w[t] || []);
              ttq.methods = ['page', 'track', 'identify', 'instances', 'debug', 'on', 'off', 'once', 'ready', 'alias', 'group', 'enableCookie', 'disableCookie'];
              ttq.setAndDefer = function (o, m) { o[m] = function () { o.push([m].concat(Array.prototype.slice.call(arguments, 0))); }; };
              for (var i = 0; i < ttq.methods.length; i++) ttq.setAndDefer(ttq, ttq.methods[i]);
              ttq.load = function (e) {
                var s = 'https://analytics.tiktok.com/i18n/pixel/events.js';
                ttq._i = ttq._i || {}; ttq._i[e] = []; ttq._i[e]._u = s; ttq._t = ttq._t || {}; ttq._t[e] = +new Date();
                ttq._o = ttq._o || {}; ttq._o[e] = {};
                var a = d.createElement('script'); a.async = true; a.src = s + '?sdkid=' + e + '&lib=' + t;
                var f = d.getElementsByTagName('script')[0]; f.parentNode.insertBefore(a, f);
              };
              ttq.load(tiktokPixel); ttq.page();
            })(window, document, 'ttq');
          }
          if (clarity) {
            (function (c, l, a, r, i, t, y) {
              c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
              t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
              y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
            })(window, document, 'clarity', 'script', clarity);
          }
        }

        if (saved === 'granted') {
          loadTags();
        } else if (!saved && banner) {
          banner.hidden = false;
        }

        document.getElementById('consent-accept')?.addEventListener('click', function () {
          localStorage.setItem(KEY, 'granted');
          if (banner) banner.hidden = true;
          loadTags();
        });

        document.getElementById('consent-reject')?.addEventListener('click', function () {
          localStorage.setItem(KEY, 'denied');
          if (banner) banner.hidden = true;
        });
      })();
    </script>
  </>
)}
