---
import { COUNTRIES, countryHreflang, type Country } from '../config/countries';
import { useT, countryPath } from '../i18n/ui';

interface Props {
  country?: Country;
}

const { country } = Astro.props;
const t = useT(country);

/**
 * Selector de mercado — el único selector del sitio. Los enlaces llevan su
 * hreflang de región para que el rastreador entienda que apuntan a otra
 * localización del mismo contenido, no a una página distinta.
 */
const tiered = [1, 2, 3].map((tier) => ({
  tier,
  list: COUNTRIES.filter((c) => c.tier === tier),
}));
---

<details class="country-switch">
  <summary aria-label={t('country.choose')}>
    {/* Sin país en la URL, CountryMemory escribe aquí el mercado recordado. */}
    <span class="mono" data-country-label>{country ? country.code.toUpperCase() : t('country.label')}</span>
    <span class="country-switch-caret" aria-hidden="true"></span>
  </summary>

  <div class="country-panel on-ink" role="group" aria-label={t('country.choose')}>
    <span class="country-panel-grip" aria-hidden="true"></span>
    <p class="eyebrow country-panel-head">{t('country.choose')}</p>

    <div class="country-panel-cols">
      {tiered.map(({ tier, list }) => (
        <ul class="linklist">
          <li class="country-panel-tier mono">{String(tier).padStart(2, '0')}</li>
          {list.map((c) => (
            <li>
              <a
                href={countryPath(c.code)}
                hreflang={countryHreflang(c)}
                data-market-pick={c.code}
                rel={c.code === country?.code ? 'nofollow' : undefined}
              >
                <span class="code">{c.code.toUpperCase()}</span>
                <span>{c.name}</span>
              </a>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</details>

<style>
  .country-switch {
    position: relative;
  }

  .country-switch > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    cursor: pointer;
    list-style: none;
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    border: 1px solid var(--color-line-ink);
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .country-switch > summary::-webkit-details-marker { display: none; }

  .country-switch > summary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-2);
  }

  .country-switch-caret {
    inline-size: 0.4375rem;
    block-size: 0.4375rem;
    border-inline-end: 1.5px solid currentColor;
    border-block-end: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
  }

  .country-switch[open] .country-switch-caret {
    transform: translateY(1px) rotate(-135deg);
  }

  /**
   * En móvil y tableta el panel es una hoja que sube desde el borde inferior,
   * la misma forma que el menú de la app: la lista de quince mercados queda
   * al alcance del pulgar en vez de colgar de la esquina superior.
   *
   * El velo es un pseudoelemento del propio <details>. Empieza bajo la
   * cabecera a propósito: así el botón del país sigue visible y pulsable, y la
   * hoja se puede cerrar con él aunque el JavaScript no llegue a correr. Con
   * JavaScript también se cierra pulsando el velo o con Escape.
   *
   * A partir de 64rem vuelve a ser un desplegable colgado del botón.
   */
  .country-panel {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 2;
    max-block-size: min(78dvh, 40rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-ink-2);
    border-top: 2px solid var(--color-accent);
    padding: 0.75rem 1.25rem calc(1.5rem + env(safe-area-inset-bottom));
    padding-inline: max(1.25rem, env(safe-area-inset-left)) max(1.25rem, env(safe-area-inset-right));
    -webkit-user-select: none;
    user-select: none;
  }

  .country-switch[open] .country-panel { animation: sheet-up 0.26s cubic-bezier(0.2, 0.8, 0.2, 1); }

  .country-switch[open]::before {
    content: '';
    position: fixed;
    inset: calc(var(--app-bar-h) + env(safe-area-inset-top)) 0 0;
    z-index: 1;
    background: var(--sheet-scrim);
    animation: sheet-fade 0.2s ease-out;
  }

  .country-panel-grip {
    display: block;
    inline-size: 2.5rem;
    block-size: 4px;
    margin: 0 auto 1rem;
    background: var(--color-line-ink);
  }

  .country-panel .linklist a { min-block-size: 2.75rem; align-items: center; }

  @media (min-width: 64rem) {
    .country-panel {
      position: absolute;
      inset-inline: auto 0;
      bottom: auto;
      top: calc(100% + 0.5rem);
      inline-size: min(92vw, 42rem);
      max-block-size: 70vh;
      padding: 1.75rem;
      border: 1px solid var(--color-line-ink);
      -webkit-user-select: auto;
      user-select: auto;
    }

    .country-switch[open] .country-panel { animation: none; }
    .country-switch[open]::before { content: none; }
    .country-panel-grip { display: none; }
    .country-panel .linklist a { min-block-size: 0; align-items: baseline; }
  }

  .country-panel-head { margin-bottom: 1.25rem; }

  .country-panel-cols {
    display: grid;
    gap: 1.5rem 2rem;
  }

  @media (min-width: 40rem) {
    .country-panel-cols { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* Botón compacto en la barra de app. */
  @media (max-width: 63.99rem) {
    .country-switch > summary {
      min-block-size: 2.25rem;
      padding: 0.375rem 0.625rem;
    }
  }

  .country-panel-tier {
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    padding-bottom: 0.5rem;
  }

  .country-panel .linklist a { font-size: 0.875rem; }
</style>

<script>
  /**
   * Cierre de la hoja de países sin pasar por el botón: pulsando el velo —el
   * clic cae en el propio <details>, fuera del panel y del summary— o con
   * Escape. En escritorio, además, al pulsar en cualquier otro sitio.
   */
  const picker = document.querySelector<HTMLDetailsElement>('.country-switch');

  if (picker) {
    picker.addEventListener('click', (event) => {
      if (event.target === picker) picker.open = false;
    });

    document.addEventListener('click', (event) => {
      const target = event.target as Element;
      if (!picker.open || picker.contains(target)) return;
      // El botón «Tu país» del menú de la app abre este panel: su propio clic
      // no puede cerrarlo al llegar aquí burbujeando.
      if (target.closest?.('[data-open-countries]')) return;
      picker.open = false;
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !picker.open) return;
      picker.open = false;
      picker.querySelector('summary')?.focus();
    });
  }
</script>
