---
import { goUrl } from '../config/affiliate';
import { STATS } from '../config/offers';
import type { Country } from '../config/countries';
import { useT } from '../i18n/ui';

interface Props {
  country?: Country;
}

const { country } = Astro.props;
const t = useT(country);
---

<div class="dock on-ink" data-visible="false" id="dock">
  <div class="dock-info">
    <span class="dock-figure mono">{STATS.minDeposit} USD</span>
    <span class="dock-label">{t('trust.deposit')}</span>
  </div>
  <a
    class="btn btn-accent dock-cta"
    href={goUrl('real', 'dock', country?.code)}
    rel="sponsored nofollow noopener"
    data-cta="dock"
  >{t('nav.cta')}</a>
</div>

<style>
  .dock-info {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    flex: none;
  }

  .dock-figure {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-paper);
  }

  .dock-label {
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .dock-cta {
    flex: 1;
    padding-block: 0.9375rem;
    font-size: 0.875rem;
  }
</style>

<script>
  // Aparece cuando el usuario ya ha leído el primer tramo de la página:
  // antes resulta intrusivo y baja la conversión.
  const dock = document.getElementById('dock');
  if (dock) {
    const onScroll = () => {
      dock.dataset.visible = String(window.scrollY > window.innerHeight * 0.6);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
