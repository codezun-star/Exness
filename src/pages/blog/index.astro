---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import Banner from '../../components/Banner.astro';
import CtaStrip from '../../components/CtaStrip.astro';

import { useT, blogPath } from '../../i18n/ui';
import { abs, readingTime } from '../../lib/seo';
import { allPosts, postSlug, formatDate } from '../../lib/blog';
import {
  graph, organization, website, webPage, breadcrumbs, itemList,
} from '../../lib/schema';

const t = useT();

const posts = await allPosts();
const url = blogPath().replace(/^\/|\/$/g, '');

const title = t('seo.blog.title');
const description = t('seo.blog.desc');

const schema = graph(
  organization(),
  website(),
  webPage({ url: abs(url), title, description, updated: new Date() }),
  breadcrumbs([
    { name: t('nav.home'), path: '' },
    { name: t('blog.title'), path: url },
  ]),
  posts.length
    ? itemList(
        t('blog.title'),
        posts.map((post) => ({
          name: post.data.title,
          path: blogPath(postSlug(post)),
        })),
      )
    : null,
);
---

<Base
  title={title}
  description={description}
  path={url}
  theme="paper"
  schema={schema}
>
  <section class="band band-paper blog-head">
    <div class="wrap">
      <p class="eyebrow">{t('nav.blog')}</p>
      <h1 class="display display-xl blog-title">{t('blog.title')}</h1>
      <p class="lede">{t('blog.sub')}</p>
    </div>
  </section>

  <section class="band-paper blog-list-band">
    <div class="wrap">
      {posts.length === 0 ? (
        <p class="blog-empty">{t('blog.empty')}</p>
      ) : (
        <ol class="post-index">
          {posts.map((post, i) => (
            <>
            {i > 0 && i % 6 === 0 && (
              <li class="post-row post-row-ad">
                <Banner seed={`blog-list-${i}`} ruled={false} double />
              </li>
            )}
            <li class="post-row">
              <a href={blogPath(postSlug(post))} class="post-link">
                <span class="post-idx mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="post-main">
                  <span class="post-title">{post.data.title}</span>
                  <span class="post-desc">{post.data.description}</span>
                </span>
                <span class="post-meta mono">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>
                  <span>{readingTime(post.body ?? '')} {t('blog.min')}</span>
                </span>
              </a>
            </li>
            </>
          ))}
        </ol>
      )}

      <Banner format="leaderboard" seed="blog-strip" />
      <Banner format="mobilebar" seed="blog-strip-m" />
      <CtaStrip source="strip-blog" />
      <Banner seed="blog-index" double />
    </div>
  </section>

  <CtaBand source="blog-index" />
</Base>

<style>
  .blog-head { padding-bottom: clamp(2rem, 4vw, 3rem); }
  .blog-title { max-width: 12ch; margin-bottom: 1.25rem; }
  .blog-list-band { padding-bottom: clamp(3rem, 6vw, 5rem); }

  .blog-empty {
    padding-block: 3rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
  }

  .post-index {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }

  .post-row { border-bottom: 1px solid var(--color-line); }

  .post-row-ad { padding-block: 0.5rem; }

  .post-link {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.5rem 1.25rem;
    padding-block: 1.75rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  @media (min-width: 56rem) {
    .post-link {
      grid-template-columns: 3.5rem minmax(0, 1fr) 12rem;
      align-items: baseline;
    }
  }

  .post-link:hover .post-title { color: var(--color-accent-ink); }

  .post-idx {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent-ink);
  }

  .post-main { display: block; min-width: 0; }

  .post-title {
    display: block;
    font-size: clamp(1.1875rem, 2.4vw, 1.625rem);
    font-weight: 700;
    letter-spacing: -0.028em;
    line-height: 1.2;
    margin-bottom: 0.5rem;
    transition: color 0.15s ease;
  }

  .post-desc {
    display: block;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 62ch;
  }

  .post-meta {
    grid-column: 2;
    display: flex;
    gap: 1rem;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  @media (min-width: 56rem) {
    .post-meta {
      grid-column: 3;
      flex-direction: column;
      gap: 0.375rem;
      text-align: end;
    }
  }
</style>
